  outcome assert_pack(payload: Bytes) {
    require payload != @0;
    constraint pack_bound == true;
  }

  outcome settle_clrty1(intent: Bytes) {
    require intent != @0;
    constraint chain_id == 1202;
  }

  outcome assert_stream_seal_021(payload: Bytes) {
    require payload != @0;
    constraint stream_seal_021_bound == true;
    constraint chain_id == 1202;
  }

